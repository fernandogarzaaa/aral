# Copy to .env and fill in your Firebase project values.
# Never commit a real .env file. Only free-tier projects are used.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# Optional. Only needed for App Check with reCAPTCHA Enterprise.
VITE_RECAPTCHA_ENTERPRISE_KEY=
